{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "simulator": {
      "developmentClient": true,
      "ios": {
        "simulator": true
      },
      "distribution": "internal",
      "channel": "simulator"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "preview"
    },
    "no-google": {
      "distribution": "internal",
      "channel": "no-google",
      "env": {
        "EXPO_PUBLIC_NO_GOOGLE_SERVICES": "true"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6755037304"
      }
    }
  }
}
