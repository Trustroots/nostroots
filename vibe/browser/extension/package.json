{
  "name": "@trustroots/nostroots-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --target=all",
    "build:chrome": "node scripts/build.mjs --target=chrome",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "dev": "node scripts/build.mjs --watch --target=chrome",
    "dev:firefox": "node scripts/build.mjs --watch --target=firefox",
    "lint": "tsc --noEmit",
    "lint:firefox": "pnpm build:firefox && node scripts/validate-firefox.mjs",
    "package:chrome": "node scripts/package.mjs chrome",
    "package:firefox": "node scripts/package.mjs firefox",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "nip06": "^1.2.0",
    "nostr-tools": "2.23.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
